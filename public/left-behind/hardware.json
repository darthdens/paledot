        {
          "id": "ing-launch",
          "text": "Ingenuity travelled to Mars attached to the belly of the Perseverance rover, launched on 30 July 2020.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html",
