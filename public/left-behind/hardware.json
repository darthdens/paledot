      "facts": [
        {
          "id": "v1-launch",
          "text": "Voyager 1 launched on 5 September 1977 on a faster, shorter path than Voyager 2, overtaking its twin to reach Jupiter first.",
          "sourceUrl": "https://science.nasa.gov/mission/voyager/planetary-voyage"
        },
        {
          "id": "v1-jup-sat",
          "text": "Voyager 1 reached Jupiter on 5 March 1979 and Saturn on 12 November 1980.",
          "sourceUrl": "https://science.nasa.gov/mission/voyager/planetary-voyage"
        },
        {
          "id": "v1-titan",
          "text": "Voyager 1's Saturn encounter, close to the moon Titan, took it out of the plane of the planets, ending its planetary tour.",
          "sourceUrl": "https://nssdc.gsfc.nasa.gov/planetary/voyager.html"
        },
        {
          "id": "v1-portrait",
          "text": "On 14 February 1990, Voyager 1 pointed its cameras back toward the Sun and took 60 frames: the first 'portrait' of our solar system seen from outside, from about 32 degrees above the plane of the planets.",
          "sourceUrl": "https://photojournal.jpl.nasa.gov/catalog/pia00451"
        },
        {
          "id": "v1-pbd",
          "text": "In the narrow-angle image of Earth, our planet is a point of light only 0.12 pixel in size, seen from more than 6 billion kilometres (4 billion miles) away.",
          "sourceUrl": "https://photojournal.jpl.nasa.gov/catalog/pia00452",
          "verify": true
        },
        {
          "id": "v1-pbd2020",
          "text": "For the image's 30th anniversary in 2020, NASA/JPL published an updated version processed with modern techniques.",
          "sourceUrl": "https://science.nasa.gov/photojournal/pale-blue-dot-revisited"
        },
        {
          "id": "v1-helio",
          "text": "Voyager 1 crossed the heliopause into interstellar space on 25 August 2012, the first spacecraft to do so.",
          "sourceUrl": "https://www.jhuapl.edu/news/news-releases/191106-voyager-2-illuminates-boundary-interstellar-space",
          "verify": true
        },
        {
          "id": "v1-lightday",
          "text": "On 18 November 2026 at 10:16:07 UTC, Voyager 1 will be 25,902,068,356 km from Earth: one light-day.",
          "sourceUrl": "https://science.nasa.gov/?p=338314"
        },
        {
          "id": "v1-instruments",
          "text": "Two of Voyager 1's science instruments still operate: the magnetometer and the plasma wave instrument. The Low-Energy Charged Particles instrument was switched off on 17 April 2026 to save power.",
          "sourceUrl": "https://science.nasa.gov/?p=338314"
        }
