        },
        {
          "id": "ing-landing",
          "text": "Ingenuity landed on Mars on 18 February 2021, attached to Perseverance, in Jezero crater.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html"
        },
        {
          "id": "ing-first",
          "text": "On 19 April 2021 it became the first aircraft to make a powered, controlled flight on another planet.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html"
        },
        {
          "id": "ing-design",
          "text": "It was designed as a technology demonstration for up to five test flights over 30 days.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html"
        },
        {
          "id": "ing-record",
          "text": "It made 72 flights, flew more than 14 times farther than planned and logged more than two hours of flight time.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html"
        },
        {
          "id": "ing-end",
          "text": "After its 72nd flight on 18 January 2024, images showed rotor-blade damage, and NASA ended the mission on 25 January 2024.",
          "sourceUrl": "https://phys.org/news/2024-01-years-mars-nasa-ingenuity-helicopter.html"
        }
      ],
