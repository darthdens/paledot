      "facts": [
        {
          "id": "a11-dates",
          "text": "Apollo 11 launched on 16 July 1969 and landed in the Sea of Tranquility on 20 July 1969.",
          "sourceUrl": "https://nssdc.gsfc.nasa.gov/planetary/lunar/lunar_artifact_impacts.html"
        },
        {
          "id": "a11-coords",
          "text": "The Lunar Module landed at about 0.674° N, 23.473° E; the laser reflector stands a few dozen metres away.",
          "sourceUrl": "https://nssdc.gsfc.nasa.gov/planetary/lunar/lunar_sites.html"
        },
        {
          "id": "a11-llr",
          "text": "The laser reflectors left by Apollo astronauts began lunar laser ranging, an experiment that is still producing results today.",
          "sourceUrl": "https://jpl.nasa.gov/news/the-apollo-experiment-that-keeps-on-giving/"
        },
        {
          "id": "a11-light-return",
          "text": "Lunar laser ranging measures a round-trip light interval of about 2.5 seconds.",
          "sourceUrl": "https://ntrs.nasa.gov/citations/19720047864"
        },
        {
          "id": "a11-recede",
          "text": "Lunar laser ranging shows the Moon is moving away from Earth by about 3.8 cm (1.5 inches) a year.",
          "sourceUrl": "https://jpl.nasa.gov/news/the-apollo-experiment-that-keeps-on-giving/"
        }
      ],
